# Export these variables in your shell; .env is NOT automatically loaded.
HA_URL=https://homeassistant.example.invalid
HA_TOKEN=
MA_CONFIG_ENTRY_ID=
# Must be the entity exported by Music Assistant for its Yandex Station player.
MA_PLAYER_ENTITY=media_player.station_lite_ma
# Optional AlexxIT/native entity. Paused before MA playback to prevent its old
# radio/artist queue from continuing over the requested track.
STATION_NATIVE_ENTITY=media_player.yandex_station_lite
YT_PROVIDER=ytmusic
